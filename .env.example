# eBay Browse API (production credentials)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Minimum seller feedback score for a listing to be considered (basic trust filter)
MIN_SELLER_FEEDBACK_SCORE=10

# ntfy.sh push notifications — pick a hard-to-guess topic name,
# anyone who knows it can read your alerts (see README)
NTFY_TOPIC=

# Turso (hosted libSQL) — the system of record for candidates, shared between
# CI runs and the future results screen. Leave both blank for local dev to
# fall back to a local file at ./data/pokecardhunter.db instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
